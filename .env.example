# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.
#
# This file is committed to version control, so make sure it contains NO real
# secrets — only placeholder values.
#
# When adding additional environment variables, the schema in "/src/env.mjs"
# should be updated accordingly.

# --- Database (Supabase PostgreSQL) ---
# Pooled connection (Supavisor, port 6543) used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) used by Prisma for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres"

# --- Clerk (authentication) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# --- Supabase REST API (used by the keep-alive cron) ---
# Found in Supabase dashboard → Project Settings → API.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"

# --- Cron ---
# Any random string. Set the SAME value in Vercel; Vercel automatically sends
# it as a Bearer token on cron requests so the keep-alive endpoint can verify
# the caller. Optional but recommended.
CRON_SECRET="some-long-random-string"
